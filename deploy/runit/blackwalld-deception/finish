#!/bin/sh
# Best-effort dataplane cleanup backstop. blackwalld normally tears the ruleset
# down itself on SIGTERM; this only matters if it was SIGKILLed (or crashed)
# and left the nft table + TPROXY policy route behind, which would black-hole
# deception traffic to a dead engine.
#
# Delegates to `blackwalld teardown`, which derives the nft table name, TPROXY
# fwmark, and policy-route table from the config's `instance=` directive — so on
# a box running two instances this removes only THIS instance's resources and
# never touches a co-located instance's live dataplane. Keep --config in sync
# with the `run` script's --config. Best-effort (`|| true`).
exec /usr/local/bin/blackwalld teardown --config /etc/blackwall/blackwall.conf 2>/dev/null || true
